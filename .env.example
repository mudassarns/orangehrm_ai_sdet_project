# Copy this file to .env and replace local placeholders.
# Never commit .env or real credentials.

# Docker Compose / MariaDB initialization.
# MARIADB_DATABASE remains empty to match the repository's existing installer flow.
MARIADB_ROOT_PASSWORD=replace_with_local_db_password
MARIADB_DATABASE=
MARIADB_USER=orangehrm
MARIADB_PASSWORD=replace_with_local_db_password

# OrangeHRM administrator used by authenticated tests.
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=replace_with_local_admin_password

# Database connection used by persistence verification tests running on the host.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orangehrm
DB_USER=root
DB_PASSWORD=replace_with_local_db_password
